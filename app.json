{
  "expo": {
    "name": "Tunnel Guard",
    "slug": "tunnel-guard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "tunnelguard",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.musty.tunnelguard",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Tunnel Guard uses Face ID to secure your SSH keys",
        "NSBluetoothAlwaysUsageDescription": "Tunnel Guard uses Bluetooth for network detection"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.musty.tunnelguard",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-background-fetch"
    ],
    "extra": {
      "engine": "musty-v1",
      "corporation": "Musty Corporations"
    }
  }
}